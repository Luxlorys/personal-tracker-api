# Application
APP_NAME="Personal Tracker API"
ENV=local                 # local | test | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
# Inside Docker Compose the host is `postgres`; running on the host it is `localhost`.
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tracker
DB_ECHO=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracker

# Redis
REDIS_URL=redis://localhost:6379/0

# Integration tests
TEST_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tracker_test
